{
  "rules": {
    "scenarios": {
      "$scenarioId": {
        ".read": "auth != null && $scenarioId.length >= 20 && $scenarioId.matches(/^[a-zA-Z0-9_-]{20,120}$/)",
        ".write": "auth != null && $scenarioId.length >= 20 && $scenarioId.matches(/^[a-zA-Z0-9_-]{20,120}$/)",
        ".validate": "newData.hasChildren(['version', 'updatedAt', 'domains'])",

        "version": { ".validate": "newData.isNumber()" },
        "updatedAt": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "activeDomainId": { ".validate": "newData.isString() && newData.val().length <= 64" },

        "domains": {
          "$domainId": {
            ".validate": "$domainId.matches(/^(auditoria-interna|controlling|finanzas-estrategicas|finanzas-negocio|fiscal|fpa|relacion-inversores|tesoreria|transacciones)$/)",

            "meta": {
              "$campoMeta": {
                ".validate": "(newData.isString() && newData.val().length <= 200) || newData.isNumber()"
              }
            },

            "targets": {
              "$indiceTarget": {
                "capacidad": { ".validate": "newData.isString() && newData.val().length <= 200" },
                "procesos": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 5" },
                "tecnologia": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 5" },
                "organizacion": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 5" },
                "$otroTarget": { ".validate": false }
              }
            },

            "items": {
              "$indice": {
                "id": { ".validate": "newData.isString() && newData.val().length <= 120" },
                "capacidad": { ".validate": "newData.isString() && newData.val().length <= 200" },
                "subcapacidad": { ".validate": "newData.isString() && newData.val().length <= 300" },
                "owner": { ".validate": "newData.isString() && newData.val().length <= 120" },
                "status": { ".validate": "newData.isString() && newData.val().length <= 40 && newData.val().matches(/^(No iniciado|En curso|Completado|Bloqueado)$/)" },
                "comentario": { ".validate": "newData.isString() && newData.val().length <= 2000" },

                "scores": {
                  "procesos": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 5" },
                  "tecnologia": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 5" },
                  "organizacion": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 5" },
                  "$otroScore": { ".validate": false }
                },

                "lastEditedBy": {
                  "uid": { ".validate": "newData.isString() && newData.val().length <= 128" },
                  "nombre": { ".validate": "newData.isString() && newData.val().length <= 60" },
                  "at": { ".validate": "newData.isString() && newData.val().length <= 40" },
                  "$otroCampoAutoria": { ".validate": false }
                },

                "$otroCampoItem": { ".validate": false }
              }
            },

            "$otroCampoDominio": { ".validate": false }
          }
        },

        "$otroCampoRaiz": { ".validate": false }
      }
    }
  }
}
